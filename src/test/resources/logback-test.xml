<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Disable MongoDB driver logs -->
    <logger name="org.mongodb.driver" level="OFF"/>
    <logger name="com.mongodb" level="OFF"/>
    <logger name="org.mongodb" level="OFF"/>

    <!-- Console Appender with colors -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{HH:mm:ss.SSS} [%thread] %highlight(%-5level) %cyan(%logger{36}) - %msg%n
            </pattern>
        </encoder>
    </appender>

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

    <!-- Optional: Debug for your own package -->
    <logger name="org.jarApiAutomation" level="DEBUG"/>
</configuration>
